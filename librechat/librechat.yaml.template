version: 1.2.1

cache: true

mcpSettings:
  allowedDomains:
    - "mcp-server"
    - "http://mcp-server:3333"

endpoints:
  custom:
    - name: "Local Ollama"
      apiKey: "${LLM_GATEWAY_API_KEY}"
      baseURL: "${LLM_GATEWAY_BASE_URL}"
      models:
        default:
${LOCAL_OLLAMA_MODEL_LIST_YAML}
        fetch: false
      titleConvo: true
      titleModel: "${LIBRECHAT_TITLE_MODEL}"
      summarize: false
      summaryModel: "${LIBRECHAT_SUMMARY_MODEL}"
${CLOUD_MODEL_ENDPOINT_YAML}

mcpServers:
  clickhouse-analytics:
    # LibreChat отправляет MCP tool calls в Python-контейнер mcp-server.
    # Ответ tools возвращается модели, а модель формирует финальный текст пользователю.
    type: streamable-http
    url: http://mcp-server:3333/mcp
    timeout: 60000
    # Этот prompt запрещает отвечать на вопросы к БД через заранее подготовленные аналитические tools.
    # Модель создает Python-коннектор под вопрос, выполняет его и только потом отвечает.
    serverInstructions: |
      Use these tools for analytics questions: create_and_run_generated_connector, update_generated_connector, run_generated_connector. Do not answer from memory.
      Act immediately with tool calls. Do not write a plan, visible reasoning, fake tool JSON, SQL for the user, or raw MCP output.
      Analytics means ClickHouse database analytics only. Generated connectors are ephemeral and deleted after run; never reuse old connector names.

      Required flow for each new database/dashboard question:
      1. Schema phase: call create_and_run_generated_connector exactly once for clickhouse_schema_<topic>. It should return helpers.analytics_schema_for_question("<user request>", include_views=True). For generic "what tables exist" questions, return helpers.analytics_schema(include_views=True).
      2. Data phase: call create_and_run_generated_connector exactly once for clickhouse_data_<topic>. It must use only real tables/columns from schema, validate them, run SQL, and return rows.
      3. Dashboard phase: only when the user asks for a graph/dashboard, call create_and_run_generated_connector exactly once for clickhouse_dashboard_<topic>. It must query ClickHouse and return helpers.grafana_dashboard_response(...).
      If a phase fails, update/run the same connector at most once. Do not create extra connectors for the same phase.

      Connector contract: plain Python, no imports or external packages. Define CONNECTOR as {"name": "<same connector_name>", "description": "...", "input_schema": {"type": "object", "properties": {}}}. Define handler(args, run_query, helpers). run_query(sql) returns list[dict].
      Helpers allowed exactly: analytics_schema_for_question(question, include_views=True), analytics_schema(include_views=True), analytics_list_tables(include_views=True), analytics_table_exists(table), analytics_columns(table), analytics_column_exists(table, column), bounded_limit(value, default=100, max_value=1000), quote_ident(name), quote_string(value), sql_literal(value), safe_sql_identifier(name), grafana_clickhouse_target(sql, ref_id='A', format='time_series'), grafana_dashboard_response(dashboard, rows=None, metadata=None).
      helpers.analytics_schema_for_question(question, include_views=True) returns compact all_tables plus detailed candidate_tables.
      helpers.analytics_schema(include_views=True) returns {"database": "analytics", "tables": [{"name": "...", "rows": "...", "columns": [...], "column_types": {...}}]}.
      helpers.analytics_columns(table) returns list[dict]. Validate every referenced table/column before run_query. Do not invent tables, columns, rows, metrics, URLs, or helper names.
      Grafana URLs must come from grafana_dashboard_response and use http://localhost:3001.
      Final answer: short Russian summary, connector names used, data result, and Grafana browserUrl/browserShortUrl when requested.
