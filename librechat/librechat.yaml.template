version: 1.2.1

cache: true

interface:
  fileSearch: true

fileConfig:
  endpoints:
    default:
      fileLimit: 5
      fileSizeLimit: 50
      totalSizeLimit: 100
  serverFileSizeLimit: 100

mcpSettings:
  allowedDomains:
    - "http://mcp-log-workflow:8000"
    - "http://mcp-grafana:8000"
    - "http://langfuse-web:3000"

modelSpecs:
  prioritize: true
  list:
    - name: "kimi-k2.6-ads"
      label: "Kimi k2.6"
      description: "ADS default: Kimi k2.6 with high-level ADS-2 log workflow and Grafana MCP enabled."
      default: true
      preset:
        endpoint: "Moonshot"
        model: "${KIMI_MODEL}"
      mcpServers:
        - "ads-log-workflow"
        - "grafana"
${OPENMODEL_MODEL_SPEC_YAML}

endpoints:
  agents:
    recursionLimit: ${LIBRECHAT_AGENTS_RECURSION_LIMIT}
    maxRecursionLimit: ${LIBRECHAT_AGENTS_MAX_RECURSION_LIMIT}

  custom:
${MODEL_ENDPOINTS_YAML}

mcpServers:
  ads-log-workflow:
    type: sse
    url: http://mcp-log-workflow:8000/sse
    timeout: 1800000
    serverInstructions: |
      Use this MCP server as a high-level ADS ClickHouse log-analysis workflow trigger.
      For every broad Elasticsearch/raw-log analysis question, call run_log_analysis exactly once with the user's question, absolute time range, source_name, and index_like when known.
      Do not manually orchestrate queue internals. Do not call or expect per-batch map tools.
      The map queue is an internal workflow mechanism: ClickHouse stores the queue and executes aiGenerate map/reduce SQL; ads-log-workflow MCP repeats the internal steps until completion, timeout, or a terminal partial result.
      Use get_log_analysis_status only when the user asks for progress on a known investigation_id.
      Use get_log_analysis_results only when the user asks for results of a known investigation_id.
      This server starts controlled ClickHouse jobs and returns the final map/reduce results. Do not use separate low-level ClickHouse tools for ADS-2 log analysis.
      The workflow stores the user question and period in ${ADS_LLM_INVESTIGATIONS_FQN}, tracks batch processing in ${ADS_LLM_MAP_QUEUE_FQN}, stores per-batch map summaries in ${ADS_LLM_MAP_RESULTS_FQN}, and stores reduce/final summaries in ${ADS_LLM_REDUCE_RESULTS_FQN}.

  grafana:
    type: sse
    url: http://mcp-grafana:8000/sse
    timeout: ${GRAFANA_MCP_TIMEOUT_MS}
    serverInstructions: |
      Use this Grafana MCP server only when the user asks to create, find, inspect, or update Grafana dashboards or visualizations.
      For ADS-2 log-analysis results, create or update the dashboard by calling create_grafana_dashboard_from_analysis with the investigation_id returned by run_log_analysis.
      create_grafana_dashboard_from_analysis is a high-level tool: it reads the investigation period and reduce/map results itself and builds the dashboard queries internally.
      If the user asks to "make/build/draw/create a graph/chart/dashboard", do not stop after returning tabular data. Create or update a Grafana dashboard/panel and return the dashboard link.
      Do not ask for separate low-level database tools to build, validate, or rerun dashboard queries for ADS-2 log-analysis dashboards.
      Never append FORMAT JSONEachRow, FORMAT JSON, or any other FORMAT clause to Grafana ClickHouse rawSql. The Grafana datasource controls the wire format.
      When returning a Grafana dashboard or panel link to the user, always use the external Grafana base URL ${GRAFANA_BASE_URL}. Do not use the LibreChat URL, the current browser origin, or localhost:3080 for Grafana links.
      If a Grafana tool returns a relative URL such as /d/<uid>/<slug>, convert it to ${GRAFANA_BASE_URL}/d/<uid>/<slug> before answering.

  langfuse:
    type: streamable-http
    url: http://langfuse-web:3000/api/public/mcp
    requiresOAuth: false
    headers:
      Authorization: "Basic ${LANGFUSE_MCP_BASIC_TOKEN}"
    chatMenu: false
